---
// Widok strony encji: renderuje gotowy PlaceModel. Zero logiki danych.
import type { PlaceModel } from '@generator';
import BaseLayout from '../layouts/BaseLayout.astro';
import StaticMap from './StaticMap.astro';
import Facts from './Facts.astro';
import LinkSection from './LinkSection.astro';
import DataTable from './DataTable.astro';
import Provenance from './Provenance.astro';

interface Props {
  model: PlaceModel;
}
const { model } = Astro.props;
const [typeLabel, ...rest] = model.subtitle.split(' · ');
---

<BaseLayout
  title={model.title}
  description={model.metaDescription}
  canonical={model.canonical}
  jsonLd={model.jsonLd}
  robots={model.robots}
  crumbs={model.crumbs}
  width="narrow"
  theme={model.type}
>
  <article>
    <header>
      <h1>{model.h1}</h1>
      {model.subtitle && (
        <p class="subtitle">
          <span class="chip chip-accent chip-type">{typeLabel}</span>
          {rest.length > 0 && <span>{rest.join(' · ')}</span>}
        </p>
      )}
    </header>

    {model.summary.map((s) => <p class="summary">{s}</p>)}
    {model.notices.map((n) => <p class="notice">{n}</p>)}

    {model.map && (
      <section aria-labelledby="h-mapa">
        <h2 id="h-mapa">Mapa</h2>
        <StaticMap map={model.map} />
      </section>
    )}

    <section aria-labelledby="h-informacje">
      <h2 id="h-informacje">Informacje</h2>
      <Facts facts={model.facts} />
      {model.factGroups.map((g) => (
        <>
          <h3>{g.heading}</h3>
          <Facts facts={g.facts} />
        </>
      ))}
    </section>

    {(model.description || model.notes.length > 0) && (
      <section aria-labelledby="h-opis">
        <h2 id="h-opis">Opis ze źródła</h2>
        {model.description && <p>{model.description}</p>}
        {model.notes.map((n) => <p>{n}</p>)}
        <p class="muted small">Treść pochodzi bezpośrednio z danych źródłowych (tag OSM <code>description</code> lub notatka redakcyjna) i nie była redagowana.</p>
      </section>
    )}

    {model.tables.map((t) => <DataTable table={t} />)}
    {model.sections.map((s) => <LinkSection section={s} />)}

    <Provenance prov={model.provenance} />
  </article>
</BaseLayout>
