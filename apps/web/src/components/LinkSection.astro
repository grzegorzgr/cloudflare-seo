---
import type { Section } from '@generator';
interface Props {
  section: Section;
}
const { section } = Astro.props;
---

{section.items.length > 0 && (
  <section aria-labelledby={`h-${section.id}`}>
    <h2 id={`h-${section.id}`}>{section.heading}</h2>
    {section.intro && <p class="muted small">{section.intro}</p>}
    <ul class="links">
      {section.items.map((it) => (
        <li>
          <span>
            <a href={it.href}>{it.title}</a>
            {it.sub && <span class="sub">{it.sub}</span>}
          </span>
          {it.meta && <span class="meta">{it.meta}</span>}
        </li>
      ))}
    </ul>
    {section.more && (
      <p class="more"><a href={section.more.href}>{section.more.label} →</a></p>
    )}
  </section>
)}
