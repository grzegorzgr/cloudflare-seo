---
import { buildPlaceModel, type Entity } from '@generator';
import { index, siteUrl } from '../../lib/data';
import PlacePage from '../../components/PlacePage.astro';

export function getStaticPaths() {
  return index.bundle.parkings.map((e) => ({ params: { slug: e.slug }, props: { entity: e } }));
}

const { entity } = Astro.props as { entity: Entity };
const model = buildPlaceModel(entity, index, siteUrl);
---

<PlacePage model={model} />
