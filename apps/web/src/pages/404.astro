---
// Cloudflare Pages serwuje dist/404.html ze statusem 404.
import BaseLayout from '../layouts/BaseLayout.astro';
import { paths, typeConfigs } from '@generator';
import { index } from '../lib/data';

const topCities = index.bundle.cities.filter((c) => (index.byHub.get(c.slug)?.parking.length ?? 0) >= 10).slice(0, 12);
---

<BaseLayout title="Nie znaleziono strony (404) – gdziemy.pl" robots="noindex">
  <article>
    <header><h1>Nie znaleziono strony</h1></header>
    <p>
      Strona o tym adresie nie istnieje. Część dawnych adresów (m.in. strony „kolekcji” i pojedynczych odcinków
      dróg prezentowanych jako szlaki) została usunięta, bo nie niosła użytecznej informacji.
    </p>
    <h2>Zacznij od miasta</h2>
    <ul>
      {topCities.map((c) => <li><a href={paths.city(c.slug)}>{c.name}</a></li>)}
    </ul>
    <h2>Albo od kategorii</h2>
    <ul>
      <li><a href={typeConfigs.parking.indexPath}>Parkingi</a></li>
      <li><a href={typeConfigs.trail.indexPath}>Szlaki rowerowe i piesze</a></li>
      <li><a href={typeConfigs.beach.indexPath}>Plaże</a></li>
      <li><a href={paths.cities}>Wszystkie miasta</a></li>
    </ul>
  </article>
</BaseLayout>
