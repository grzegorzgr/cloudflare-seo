---
import { buildRegionModel } from '@generator';
import { index, siteUrl } from '../../lib/data';
import HubPage from '../../components/HubPage.astro';

export function getStaticPaths() {
  return index.bundle.regions.map((r) => ({ params: { region: r.slug } }));
}

const { region } = Astro.params;
const model = buildRegionModel(region!, index, siteUrl);
---

<HubPage model={model} width="narrow" />
