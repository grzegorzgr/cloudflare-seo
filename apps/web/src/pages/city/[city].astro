---
import { buildCityModel } from '@generator';
import { index, siteUrl } from '../../lib/data';
import HubPage from '../../components/HubPage.astro';

export function getStaticPaths() {
  return index.bundle.cities.map((c) => ({ params: { city: c.slug } }));
}

const { city } = Astro.params;
const model = buildCityModel(city!, index, siteUrl);
---

<HubPage model={model} width="narrow" />
